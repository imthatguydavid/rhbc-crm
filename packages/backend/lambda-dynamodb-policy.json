{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-2:593793033432:table/rhbc-families",
        "arn:aws:dynamodb:us-west-2:593793033432:table/rhbc-families/index/*",
        "arn:aws:dynamodb:us-west-2:593793033432:table/rhbc-people",
        "arn:aws:dynamodb:us-west-2:593793033432:table/rhbc-people/index/*"
      ]
    }
  ]
}
